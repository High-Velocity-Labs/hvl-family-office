  "scenarios": [
    {
      "id": "scen_baseline",
      "name": "Executive Baseline Plan",
      "description": "Current trajectory with the SF residence, dual executive incomes, $230k/yr of core living spend, tuition for all three children, the $110k/yr gifting program, and both spouses retiring at 65. The $880k mortgage at 2.875% (25 years left, about $49k a year) is entered in Settings, and take-home pay of about $495k leaves about $216k a year after living costs and the mortgage. Portfolio withdrawals begin in 2045, and on the fixed return path neither the taxable account nor the retirement accounts run out before age 100. Social Security is estimated from earnings: about $52k a year from 2047 and $105k together from 2048. Monte Carlo success (liquid assets only) is about 91.3%.",
      "color": "#3B82F6",
      "is_baseline": true,
      "parent_id": null,
      "primary_retirement_age": 65,
      "spouse_retirement_age": 65,
      "annual_living_spend": 230000.0,
      "annual_savings": 250000.0,
      "equity_growth_preset": "moderate"
    },
    {
      "id": "scen_jones_early_retire",
      "name": "Early Retirement at Age 55",
      "description": "Both spouses stop full-time work at 55 (Alex in 2035, Sarah in 2036) and living expenses come from the portfolio. Withdrawals begin in 2035; the taxable account is used up around 2038 (age 57) and the retirement accounts around 2045 (age 64). After that the plan sells Nexus and CloudFlow stock, which on the fixed return path lasts through age 100, but the Monte Carlo test counts liquid assets only. Social Security is claimed at 67 (about $51k a year from 2047, $102k together from 2048). Monte Carlo success is about 36.4%, against about 91.3% for the baseline.",
      "color": "#10B981",
      "is_baseline": false,
      "parent_id": "scen_baseline",
      "primary_retirement_age": 55,
      "spouse_retirement_age": 55,
      "annual_savings": 60000.0
    },
    {
      "id": "scen_jones_tahoe_retreat",
      "name": "Tahoe Mountain Home & Retire at 58",
      "description": "Branches from Early Retirement at 55 but works three more years (to 58) to afford a $1.8M Lake Tahoe second home bought in 2028: $720k (40%) down from the taxable brokerage, a $1.08M 30-year mortgage at 5.5%, and $30k/yr of carrying costs. About $0.80M of cash leaves in 2028; the taxable account is used up around 2036 (age 55) and the retirement accounts around 2044 (age 63), after which the plan sells company stock, which lasts through age 100 on the fixed return path. Monte Carlo success is about 37.4%, close to retiring at 55 without the home (about 36.4%): the extra working years roughly pay for the house.",
      "color": "#8B5CF6",
      "is_baseline": false,
      "parent_id": "scen_jones_early_retire",
      "primary_retirement_age": 58,
      "spouse_retirement_age": 58,
      "added_event_ids": ["evt_jones_tahoe_home"]
    },
    {
      "id": "scen_jones_aggressive_equity",
      "name": "High-Growth Equity Liquidity Event",
      "description": "Adds a one-time $500k liquidity windfall in 2029 (about $543k after inflation) and assumes Nexus and CloudFlow stock grows 14% a year instead of 8%. The growth preset changes company-stock growth only; portfolio returns are unchanged. Monte Carlo success is about 93.1%, against about 91.3% for the baseline.",
      "color": "#F59E0B",
      "is_baseline": false,
