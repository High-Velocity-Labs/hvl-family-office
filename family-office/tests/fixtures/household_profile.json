 "scenarios": [
  {
   "id": "scen_baseline",
   "name": "Executive Baseline Plan",
   "description": "Current trajectory with the SF residence, dual executive incomes, $230k/yr of core living spend, tuition for all three children, the $110k/yr gifting program, and both spouses retiring at 65. Portfolio withdrawals begin in 2045, and on the fixed return path neither the taxable account nor the retirement accounts run out before age 100. Monte Carlo success (liquid assets only) is about 88.7%.",
   "color": "#3B82F6",
   "is_baseline": true,
   "parent_id": null,
   "primary_retirement_age": 65,
   "spouse_retirement_age": 65,
   "annual_living_spend": 230000.0,
   "annual_savings": 250000.0,
   "equity_growth_preset": "moderate"
  },
  {
   "id": "scen_jones_early_retire",
   "name": "Early Retirement at Age 50",
   "description": "Both spouses stop full-time work at 50 (Casey in 2030, Jordan in 2031) and living expenses come from the portfolio. The taxable account is used up around 2033 (age 52) and the retirement accounts around 2038 (age 57); after that the plan relies on selling Nexus and CloudFlow stock, which lasts until about 2054 (age 73). Monte Carlo success is about 16.5%.",
   "color": "#10B981",
   "is_baseline": false,
   "parent_id": "scen_baseline",
   "primary_retirement_age": 50,
   "spouse_retirement_age": 50,
   "annual_savings": 60000.0
  },
  {
   "id": "scen_jones_tahoe_retreat",
   "name": "Tahoe Mountain Home & Early Exit",
   "description": "Branches from Early Retirement at 50 to buy a $2.5M Lake Tahoe second home in 2028: $1M (40%) down from the taxable brokerage, a $1.5M 30-year mortgage at 5.5%, and $45k/yr of carrying costs. About $1.11M of cash leaves in 2028; the taxable account is used up around 2030 (age 49) and the retirement accounts around 2034 (age 53), so the plan then depends on selling company stock, which itself runs out around 2039 (age 58), after which spending is unfunded. Monte Carlo success is under 1%.",
   "color": "#8B5CF6",
   "is_baseline": false,
   "parent_id": "scen_jones_early_retire",
   "added_event_ids": [
    "evt_jones_tahoe_home"
   ]
  },
  {
   "id": "scen_jones_aggressive_equity",
   "name": "High-Growth Equity Liquidity Event",
   "description": "Adds a one-time $500k liquidity windfall in 2029 (about $543k after inflation) and assumes Nexus and CloudFlow stock grows 14% a year instead of 8%. The growth preset changes company-stock growth only; portfolio returns are unchanged.",
