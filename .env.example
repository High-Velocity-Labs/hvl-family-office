# ==============================================================================
# HVL FAMILY OFFICE — CONFIGURATION (.env)
# Copy this file to `.env` before running from source or Docker:
#   cp .env.example .env
# ==============================================================================

# 1. Runtime Mode
# - LOCAL_MODE=1 (Default): Single-household Local Desktop / Home Server mode.
#   Requires zero external auth setup (supports offline PIN / Passphrase unlock,
#   mobile Wi-Fi QR pairing, and single-file .fovault backups).
# - LOCAL_MODE=0: Multi-tenant Cloud Server mode (requires Google OAuth + ADMIN_EMAIL).
LOCAL_MODE=1

# 2. Local Desktop & Network Overrides (Optional)
# Port for the local or Docker server (default: 5050)
FAMILY_OFFICE_PORT=5050
# Custom directory for SQLite databases, .mm/.secret.key, and backups/ (optional)
# FAMILY_OFFICE_DATA_DIR=/custom/path/to/vault
# Set to 1 to run desktop_app.py as a headless background server without opening a GUI window
# FAMILY_OFFICE_HEADLESS=0

# 3. Cryptographic Keys (Auto-generated in .mm/.secret.key when LOCAL_MODE=1 if omitted)
# Generate Fernet key: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=your-fernet-key-here
# Generate Flask session secret: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your-random-flask-secret-key

# 4. Cloud Server Owner & Google OAuth 2.0 (Required when LOCAL_MODE=0; Optional in LOCAL_MODE=1)
# Super-Admin email that claims Household #1 and can generate 'New Household' Magic Invites:
ADMIN_EMAIL=admin@example.com
# Enable Google Drive API in Google Cloud Console for the non-sensitive '.../auth/drive.appdata' vault scope:
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# 5. Google Gemini API Key (Optional — can also be entered in-app under Settings -> Data Integrations & AI Key)
# Used for AI Financial Advisor tool-calling & in-memory IRS Transcript / Form W-2 PDF extraction.
GEMINI_API_KEY=your-gemini-api-key-here
